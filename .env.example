SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional: limit results to Spotbot's posts
SLACK_SPOTBOT_USER_ID=

# --- Quotes (Slack channel -> /api/quotes) ---
# Channel the quotes are read from; the club's is C7CJ73H55. Leave empty for no quotes.
# The bot must be a member (/invite @bot). Read-only: nothing is ever posted there.
SLACK_QUOTES_CHANNEL_ID=

# --- Chumming photos (Slack channel -> /api/chum -> the carousel) ---
# Channel whose six newest photos join the carousel; the club's is C032XEA9PTJ. Leave empty for none.
# The bot must be a member (/invite @bot). Read-only: nothing is ever posted there.
SLACK_CHUM_CHANNEL_ID=

# --- Song requests (Slack channel -> Spotify) ---
# Channel where people post Spotify track links. The bot must be a member (/invite @bot).
# Messages without a Spotify track link are ignored.
SLACK_SONGS_CHANNEL_ID=
# Set to 1 to have the bot reply in the request's thread ("Queued: ..."). Off by default.
SLACK_SONGS_REPLY=
# Spotify developer app (https://developer.spotify.com/dashboard). The app must list the redirect
# URI http://127.0.0.1:3000/api/spotify/callback exactly; then open
# http://127.0.0.1:3000/api/spotify/login once on this computer to connect the account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Where requested songs go: queue (default; something must be playing), playlist, or both.
SPOTIFY_SONGS_MODE=queue
# Playlist and both modes only: playlist ID or open.spotify.com/playlist/... link, owned by the
# connected account. Leave empty to have a private "B@B Song Requests" playlist created on first use.
SPOTIFY_SONGS_PLAYLIST_ID=
# Jam QR: invite link of the Spotify Jam started by hand on this Mac (from the Jam's share options), e.g.
# https://open.spotify.com/socialsession/... or https://spotify.link/... Mentioning the bot in the songs
# channel with the word "jam" shows it as a QR code for a minute. "@bot jam <link>" in Slack stores a
# new link, which wins over this one. Set it again whenever the Jam is restarted.
SPOTIFY_JAM_URL=
# Optional tuning: minutes a request may wait before it is dropped, seconds between polls (0 = off).
# SONGS_MAX_AGE_MINUTES=30
# SONGS_POLL_SECONDS=20

# --- News and tweets feed (/api/feed) ---
# Everything here is optional: news (RSS) and Bluesky posts need no key.
# Tweets from X need a paid X API Bearer Token (console.x.com; $0.005 per post read, no free tier).
# Accounts are listed in lib/feed-sources.ts. Leave empty for a feed without tweets.
X_BEARER_TOKEN=
# Optional: read one X List (numeric ID) instead of the account list. Cheapest: one request per poll.
# X_LIST_ID=
# Optional: hard stop on X post reads per UTC day (default 300, about $1.50).
# X_MAX_READS_PER_DAY=300
# An AI agent picks the items. FEED_AGENT: codex (default; OpenAI's Codex CLI, logged in on this
# machine), claude (Messages API if ANTHROPIC_API_KEY is set, else the logged-in `claude` command),
# or off (no AI: newest items, taking turns between sources). If the chosen agent fails, the other
# is tried once.
# FEED_AGENT=codex
# ANTHROPIC_API_KEY=
# Optional: models, and paths to the CLIs if they are not on PATH.
# FEED_CODEX_MODEL=gpt-6-luna
# FEED_CLAUDE_MODEL=claude-haiku-4-5
# CODEX_CLI_PATH=/Users/you/.local/bin/codex
# FEED_CLAUDE_BIN=/Users/you/.local/bin/claude
# Optional tuning: minutes between selections (5 or more), seconds before giving up on an agent,
# off to drop the Bluesky source.
# FEED_REFRESH_MINUTES=15
# FEED_AGENT_TIMEOUT_SECONDS=90
# FEED_BLUESKY=off
# Newsworthy tokens (/api/newsworthy): the same agent also picks up to six tokens that are in the
# news and writes a short note on each. Minutes between runs (5 or more; default 30; 0 = off).
# FEED_AGENT=off turns it off too.
# NEWSWORTHY_REFRESH_MINUTES=30

# --- Upcoming events (/api/events) ---
# Google Calendar ID; its public iCal feed is read without a key. Works only if the calendar is
# public ("Make available to public" in its settings). Default: the Blockchain at Berkeley calendar.
# EVENTS_CALENDAR_ID=jt8mpvuljj288e0pu5s55ocus0@group.calendar.google.com
# For a calendar that is not public: its "Secret address in iCal format" (calendar settings >
# Integrate calendar). It is a password: anyone holding it can read every event. Wins over the ID.
EVENTS_ICS_URL=
