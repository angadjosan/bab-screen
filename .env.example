SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional: limit results to Spotbot's posts
SLACK_SPOTBOT_USER_ID=

# --- Song requests (Slack channel -> Spotify) ---
# Channel where people post song requests. The bot must be a member (/invite @bot).
SLACK_SONGS_CHANNEL_ID=
# Set to 1 to have the bot reply in the request's thread ("Added to the playlist: ..."). Off by default.
SLACK_SONGS_REPLY=
# Spotify developer app (https://developer.spotify.com/dashboard). The app must list the redirect
# URI http://127.0.0.1:3000/api/spotify/callback exactly; then open
# http://127.0.0.1:3000/api/spotify/login once on this computer to connect the account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Where requested songs go: playlist (default), queue (needs Premium + something playing), or both.
SPOTIFY_SONGS_MODE=playlist
# Optional: playlist ID or open.spotify.com/playlist/... link, owned by the connected account.
# Leave empty to have a private "B@B Song Requests" playlist created on first use.
SPOTIFY_SONGS_PLAYLIST_ID=
# Optional: Claude API key for understanding free-text requests. Without it the local `claude`
# CLI (Claude Code login) is used; without either, only Spotify track links work.
ANTHROPIC_API_KEY=
# Optional tuning: model, minutes a request may wait before it is dropped, seconds between polls (0 = off).
# SONGS_CLAUDE_MODEL=claude-haiku-4-5
# SONGS_MAX_AGE_MINUTES=30
# SONGS_POLL_SECONDS=20
